{
  "manifest_version": 3,
  "name": "Bookmark Hidden",
  "version": "0.3.0",
  "description": "Truly hide bookmarks & folders from Chrome and restore them anytime.",
  "permissions": ["bookmarks", "storage", "downloads"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Bookmark Hidden",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  }
}